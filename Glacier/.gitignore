# --- Wails / Build Artifacts ---
# The compiled executable (Glacier.exe)
build/bin/

# The compiled frontend assets (autogenerated)
frontend/dist/

# Wails auto-generated bindings (these regenerate when you run 'wails dev')
wailsjs/

# --- Dependencies ---
# Node modules (heavy folder, recreated via npm install)
node_modules/
frontend/node_modules/

# --- IDE & OS Settings ---
# VS Code user settings (optional, but usually good to ignore)
.vscode/

# Windows/Mac system files
Thumbs.db
.DS_Store

# --- Go Specific ---
# In case you ever create a workspace file
go.work